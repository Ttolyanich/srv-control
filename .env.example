# ==============================================================================
# Шаблон конфигурации окружения для SRV-Control
# Переименуйте этот файл в .env и настройте параметры ниже
# ==============================================================================

# Секретный ключ для подписи сессий Flask (обязательно смените в продакшне)
# Для генерации случайного ключа выполните команду:
# openssl rand -hex 16
SECRET_KEY=srv_control_secret_key_9988_secure_prod

# Ключ Fernet для шифрования паролей и токенов PVE/SSH в базе данных
# Для генерации безопасного ключа Fernet выполните команду:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# URL подключения к базе данных (по умолчанию SQLite)
# Пример для PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URI=sqlite:///srv_control.db

# Настройки сетевого интерфейса веб-сервера
BIND_HOST=0.0.0.0
BIND_PORT=5002

# Режим отладки Flask (1 - включен, 0 - выключен для продакшна)
FLASK_DEBUG=0
FLASK_ENV=production
