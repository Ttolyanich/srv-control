# ==============================================================================
# Шаблон конфигурации окружения для SRV-Control
# Переименуйте этот файл в .env и настройте параметры ниже
# ==============================================================================

# Секретный ключ для подписи сессий Flask (обязательно смените в продакшне)
# Для генерации случайного ключа выполните команду:
# openssl rand -hex 16
SECRET_KEY=srv_control_secret_key_9988_secure_prod

# Ключ Fernet для шифрования паролей и токенов PVE/SSH в базе данных
# Для генерации безопасного ключа Fernet выполните команду:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# URL подключения к базе данных (по умолчанию SQLite)
# Пример для PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URI=sqlite:///srv_control.db

# Настройки сетевого интерфейса веб-сервера
BIND_HOST=0.0.0.0
BIND_PORT=5002

# Режим отладки Flask (1 - включен, 0 - выключен для продакшна)
FLASK_DEBUG=0
FLASK_ENV=production

# ==============================================================================
# Авторизация через Active Directory (LDAP)
# ==============================================================================
# Включить авторизацию через AD (true / false).
# Локальные пользователи из БД (например, резервный admin) продолжают работать.
LDAP_ENABLED=false

# Адрес контроллера домена (например: ldap://10.11.4.254 или ldaps://dc.corp.local)
LDAP_SERVER=ldap://10.11.4.254
LDAP_DOMAIN=corp.local
LDAP_BASE_DN=DC=corp,DC=local

# Сервисная учетная запись для поиска пользователя по Email (mail / userPrincipalName)
# Если не указана, используется прямой вход (Direct Bind) по email или DOMAIN\username
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Опционально: фильтр группы доступа и маппинг ролей в SRV-Control
# Если LDAP_REQUIRED_GROUP задана, войти смогут только участники этой группы AD
LDAP_REQUIRED_GROUP=
# Участники этой группы автоматически получают роль 'admin' при первом входе
LDAP_ADMIN_GROUP=
# Участники этой группы автоматически получают роль 'financier' при первом входе
LDAP_FINANCIER_GROUP=
# Список логинов или email через запятую, которым выдается роль 'admin' или 'financier' (без привязки к группам AD)
LDAP_ADMIN_USERS=
LDAP_FINANCIER_USERS=
# Проверять вложенные группы AD (LDAP_MATCHING_RULE_IN_CHAIN)
LDAP_NESTED_GROUPS=true
LDAP_TIMEOUT=5
